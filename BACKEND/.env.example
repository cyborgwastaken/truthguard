# Copy this file to BACKEND/.env and change what you need. Git ignores .env: never commit it.
# The backend reads these when it is started from the BACKEND folder.
TRUTHGUARD_DATABASE_URL=postgresql+psycopg://truthguard:truthguard@localhost:5433/truthguard
TRUTHGUARD_CORS_ORIGINS=http://localhost:5173

# The model the pipeline calls once the API is wired up (T13/T14). Groq retires models from time to time,
# so check the current list at https://console.groq.com/docs/models before choosing.
TRUTHGUARD_LLM_MODEL=openai/gpt-oss-120b

# The Groq API key is NOT read from this file. Set it as an environment variable in your terminal:
#   PowerShell:  $env:GROQ_API_KEY = "your-key"
#   bash:        export GROQ_API_KEY="your-key"
