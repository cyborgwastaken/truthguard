# Copy this file to BACKEND/.env and change what you need. Git ignores .env: never commit it.
# The backend reads these when it is started from the BACKEND folder.
TRUTHGUARD_DATABASE_URL=postgresql+psycopg://truthguard:truthguard@localhost:5433/truthguard
TRUTHGUARD_CORS_ORIGINS=http://localhost:5173

# The language model. Groq retires models from time to time, so check the current list at
# https://console.groq.com/docs/models before choosing.
TRUTHGUARD_LLM_MODEL=openai/gpt-oss-120b

# The Groq API key, also read from the environment variable GROQ_API_KEY. Never commit the real .env.
GROQ_API_KEY=

# live: call Groq. record: call Groq and store every reply. cache: reuse stored replies, call Groq for the rest.
# replay: stored replies only (no key needed). Answers from a replay are labelled "Replayed recording".
TRUTHGUARD_LLM_MODE=live
